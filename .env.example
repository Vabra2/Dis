# ==============================================
# Dis - Anonymous Chat Platform Configuration
# ==============================================

# ----------------
# General Settings
# ----------------
# Your domain (without https://)
DOMAIN=example.com
# Alternative: use IP address for testing
# DOMAIN=192.168.1.100

# Protocol (http or https)
PROTOCOL=https

# Server timezone
TZ=UTC

# ----------------
# MongoDB Settings
# ----------------
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=revolt
MONGODB_USERNAME=revolt
# GENERATE THIS: openssl rand -base64 32
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD

# MongoDB encryption key (for at-rest encryption)
# GENERATE THIS: openssl rand -base64 32
MONGODB_ENCRYPTION_KEY=CHANGE_ME_MONGODB_ENCRYPTION_KEY

# ----------------
# Redis Settings
# ----------------
REDIS_HOST=redis
REDIS_PORT=6379
# GENERATE THIS: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ----------------
# MinIO (S3) Settings
# ----------------
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=revolt-files
# GENERATE THIS: openssl rand -base64 16
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
# GENERATE THIS: openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ----------------
# Revolt Backend Settings
# ----------------
# Delta (REST API)
DELTA_PORT=8000
# GENERATE THIS: openssl rand -hex 32
DELTA_SECRET=CHANGE_ME_DELTA_SECRET

# Bonfire (WebSocket)
BONFIRE_PORT=9000

# January (Web Frontend)
JANUARY_PORT=3000

# Vortex (Voice Server)
VORTEX_PORT=9001
VORTEX_EXTERNAL_HOST=${DOMAIN}
VORTEX_EXTERNAL_PORT=443

# ----------------
# Encryption Settings
# ----------------
# E2E Encryption master key
# GENERATE THIS: openssl rand -base64 32
E2E_MASTER_KEY=CHANGE_ME_E2E_MASTER_KEY

# Signal Protocol server key
# GENERATE THIS: openssl rand -base64 32
SIGNAL_SERVER_KEY=CHANGE_ME_SIGNAL_SERVER_KEY

# ----------------
# Authentication Settings
# ----------------
# JWT secret for session tokens
# GENERATE THIS: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET

# JWT expiration (in seconds)
JWT_EXPIRATION=2592000

# Argon2 settings
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# PoW CAPTCHA difficulty (number of leading zeros required)
POW_DIFFICULTY=4

# ----------------
# Email Settings (Optional)
# ----------------
# Enable email verification (true/false)
EMAIL_ENABLED=false

# SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
# GENERATE THIS: strong password for your SMTP account
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# Email encryption key (for storing encrypted emails)
# GENERATE THIS: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=CHANGE_ME_EMAIL_ENCRYPTION_KEY

# ----------------
# Tor Settings
# ----------------
# Enable Tor hidden service (true/false)
TOR_ENABLED=true

# Tor SOCKS proxy
TOR_PROXY=socks5://tor:9050

# ----------------
# Logging Settings
# ----------------
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable log anonymization (true/false)
LOG_ANONYMIZATION=true

# Log retention days
LOG_RETENTION_DAYS=7

# ----------------
# Security Settings
# ----------------
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=50

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# ----------------
# Caddy Settings
# ----------------
# Email for Let's Encrypt (leave empty for self-signed)
ACME_EMAIL=

# Enable automatic HTTPS (true/false)
AUTO_HTTPS=true

# ----------------
# Backup Settings
# ----------------
# Enable automated backups (true/false)
BACKUP_ENABLED=true

# Backup encryption password
# GENERATE THIS: openssl rand -base64 32
BACKUP_PASSWORD=CHANGE_ME_BACKUP_PASSWORD

# Backup retention (number of backups to keep)
BACKUP_RETENTION=7

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# ----------------
# Advanced Settings
# ----------------
# Enable debug mode (true/false) - DO NOT USE IN PRODUCTION
DEBUG=false

# WebRTC STUN/TURN servers (comma-separated)
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302
# TURN server (optional, format: turn:user:pass@host:port)
WEBRTC_TURN_SERVER=

# Maximum WebSocket connections
MAX_WS_CONNECTIONS=10000

# Database connection pool size
DB_POOL_SIZE=50
